{
  "Cart Title": {
    "locatorType": "XPATH",
    "locatorValue": "//div[contains(@class,'Cart-Title')]/h1"
  },
  "Cart Items Count Text": {
    "locatorType": "XPATH",
    "locatorValue": "//div[contains(@class,'Cart-Title')]/p"
  },
  "Free Delivery Banner": {
    "locatorType": "XPATH",
    "locatorValue": "//p[normalize-space()='Sizin pulsuz çatdırılmanız var']"
  },
  "Select All Checkbox": {
    "locatorType": "XPATH",
    "locatorValue": "//div[@data-info='select-all']//label"
